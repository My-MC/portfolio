---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { navigation, profile, site } from '../data/site';
import {
  type Breadcrumb,
  breadcrumbList,
  defaultSocialImage,
  isPreview,
  person,
  type SocialImage,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: SocialImage;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
  ogType?: 'website' | 'article' | 'profile';
  publishedAt?: Date;
  updatedAt?: Date;
}
const {
  title,
  description = site.description,
  image = defaultSocialImage,
  noindex = false,
  structuredData = [],
  breadcrumbs = [],
  ogType = 'website',
  publishedAt,
  updatedAt,
} = Astro.props;
const canonical = new URL(
  noindex && Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname,
  site.url,
).href;
const pageTitle = title
  ? `${title} | ${site.name}`
  : `${profile.displayName}（${profile.handle}）｜ポートフォリオ・ブログ`;
const preview =
  import.meta.env.DEV ||
  isPreview(site.preview, import.meta.env.WORKERS_CI_BRANCH);
const structured = [
  person(),
  ...(Astro.url.pathname === '/'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          '@id': new URL('/#website', site.url).href,
          name: site.name,
          url: new URL('/', site.url).href,
        },
      ]
    : []),
  ...structuredData,
  ...(breadcrumbs.length ? [breadcrumbList(breadcrumbs)] : []),
];
const bootLines = [
  'Started my-mc.service',
  'Reached target Network',
  'Mounted /home/my/projects',
  'Started antenna.service',
  'Loaded neofetch',
  'Reached target Portfolio',
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <Font cssVariable="--font-sans-jp" />
    <Font cssVariable="--font-mono-latin" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <meta name="author" content={profile.displayName}>
    <link rel="canonical" href={canonical}>
    {(noindex || preview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={new URL(image.src, site.url).href}>
    <meta property="og:image:width" content={String(image.width)}>
    <meta property="og:image:height" content={String(image.height)}>
    <meta property="og:image:type" content={image.type}>
    <meta property="og:image:alt" content={image.alt}>
    {ogType === 'article' && publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {ogType === 'article' && updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    <meta property="og:locale" content="ja_JP">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={new URL(image.src, site.url).href}>
    <meta name="twitter:image:alt" content={image.alt}>
    <meta name="color-scheme" content="dark light">
    <meta
      name="theme-color"
      content="#f6f7f4"
      media="(prefers-color-scheme: light)"
    >
    <meta
      name="theme-color"
      content="#0c1012"
      media="(prefers-color-scheme: dark)"
    >
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name}のブログ`}
      href="/rss.xml"
    >
    <link rel="sitemap" href="/sitemap-index.xml">
    <script is:inline>
    (() => {
      let preference = 'system';
      try {
        const stored = localStorage.getItem('portfolio-theme');
        if (stored === 'light' || stored === 'dark') preference = stored;
      } catch {
        /* 保存できない場合はOS設定に追従 */
      }
      const theme =
        preference === 'system'
          ? matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : preference;
      document.documentElement.dataset.themePreference = preference;
      document.documentElement.dataset.theme = theme;
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
        meta.setAttribute('content', theme === 'dark' ? '#0c1012' : '#f6f7f4');
        meta.removeAttribute('media');
      });
      // 動きを減らす設定でなければアニメーションを有効にする
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.dataset.motion = 'on';
        // トップの初回表示（タブごと）だけ起動ログを流す。?boot で再生。
        try {
          const force = new URLSearchParams(location.search).has('boot');
          if (
            location.pathname === '/' &&
            (force || !sessionStorage.getItem('portfolio-booted'))
          ) {
            document.documentElement.dataset.boot = '';
            sessionStorage.setItem('portfolio-booted', '1');
          }
        } catch {
          /* 保存できない環境では起動ログを省略 */
        }
      }
    })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">本文へ移動</a>
    <div id="boot" class="boot" aria-hidden="true" data-boot-screen>
      <div class="boot-log">
        {bootLines.map((line, index) => (
          <p style={`--n: ${index}`}>
            <span class="boot-ok">{'[\u00a0\u00a0OK\u00a0\u00a0]'}</span>
            {`\u00a0${line}`}
          </p>
        ))}
        <p class="boot-skip" style={`--n: ${bootLines.length}`}>
          click / tap to skip
        </p>
      </div>
    </div>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${profile.displayName} ホーム`}>
          <span class="brand-mark" aria-hidden="true">~/</span>
          <span class="brand-name">{profile.handle.toLowerCase()}</span>
        </a>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <button
            type="button"
            class="icon-button"
            aria-label="サイト内を検索"
            data-search-open
          >
            <Icon name="search" />
          </button>
          <fieldset class="theme-picker" aria-label="表示テーマ">
            {(
              [
                ['light', 'sun', 'ライト'],
                ['dark', 'moon', 'ダーク'],
                ['system', 'monitor', 'OS設定に従う'],
              ] as const
            ).map(([value, icon, label]) => (
              <button
                type="button"
                class="icon-button theme-button"
                data-theme-value={value}
                aria-label={label}
                aria-pressed="false"
                title={label}
              >
                <Icon name={icon} size={17} />
              </button>
            ))}
          </fieldset>
          <button
            type="button"
            class="icon-button mobile-toggle"
            id="menu-toggle"
            aria-label="メニューを開く"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav
        id="mobile-nav"
        class="mobile-nav container"
        aria-label="モバイルナビゲーション"
      >
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <fieldset class="mobile-theme" aria-label="表示テーマ">
          <legend class="mobile-theme-label mono">theme</legend>
          {(
            [
              ['light', 'sun', 'ライト'],
              ['dark', 'moon', 'ダーク'],
              ['system', 'monitor', 'OS設定'],
            ] as const
          ).map(([value, icon, label]) => (
            <button
              type="button"
              class="theme-chip"
              data-theme-value={value}
              aria-pressed="false"
            >
              <Icon name={icon} size={16} />
              {label}
            </button>
          ))}
        </fieldset>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a
            href="/"
            class="brand"
            aria-label={`${profile.displayName} ホーム`}
          >
            <span class="brand-mark" aria-hidden="true">~/</span>
            <span class="brand-name">{profile.handle.toLowerCase()}</span>
          </a>
          <p class="footer-tagline">{profile.tagline}</p>
        </div>
        <nav class="footer-nav" aria-label="フッター">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {profile.displayName}</span>
        <span class="mono">built with astro + bun · served by cloudflare</span>
      </div>
      {preview && (
        <p class="container preview-note">
          開発プレビューです（検索エンジンには掲載されません）。
        </p>
      )}
    </footer>
    <dialog id="search-dialog" aria-labelledby="search-title">
      <div class="search-heading">
        <h2 id="search-title">記事・プロジェクトを検索</h2>
        <button
          type="button"
          class="icon-button"
          data-search-close
          aria-label="検索を閉じる"
        >
          <Icon name="close" />
        </button>
      </div>
      <label for="search-input" class="sr-only">検索キーワード</label>
      <div class="search-field">
        <Icon name="search" />
        <input
          id="search-input"
          type="search"
          placeholder="例：BGP、Proxmox、Rust"
          autocomplete="off"
        >
      </div>
      <p id="search-status" role="status" aria-live="polite">
        キーワードを入力してください。
      </p>
      <ul id="search-results"></ul>
      <p class="search-hint">ESCで閉じる</p>
    </dialog>
    <script>
    import '../lib/browser';
    </script>
    <noscript>
      <style>
      .header-actions button {
        display: none;
      }
      .mobile-nav {
        display: flex;
        flex-wrap: wrap;
      }
      .filter-controls,
      .mobile-theme {
        display: none;
      }
      </style>
    </noscript>
  </body>
</html>
