---
interface Props {
  command: string;
  title: string;
  description?: string;
}
const { command, title, description } = Astro.props;
---

<header class="page-heading">
  <p class="prompt"><span class="prompt-sign">$</span> {command}</p>
  <h1>{title}</h1>
  {description && <p class="page-description">{description}</p>}
</header>
