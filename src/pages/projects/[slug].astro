---
import { render } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentImage from '../../components/ContentImage.astro';
import { statuses } from '../../data/tags';
import Base from '../../layouts/Base.astro';
import { publishedProjects } from '../../lib/content';
import { socialImage } from '../../lib/social-image';

export async function getStaticPaths() {
  return (await publishedProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const image = await socialImage(data.cover, data.coverAlt);
const breadcrumbs = [
  { name: 'ホーム', path: '/' },
  { name: 'Projects', path: '/projects/' },
  { name: data.title, path: `/projects/${project.id}/` },
];
---

<Base
  title={data.title}
  description={data.description}
  image={image}
  breadcrumbs={breadcrumbs}
>
  <div class="container page-content narrow">
    <Breadcrumbs items={breadcrumbs} />
    <article data-pagefind-body>
      <header class="article-header">
        <div class="post-meta">
          <span class:list={['status', `status-${data.status}`]}>
            {statuses[data.status]}
          </span>
          {data.role && <span>{data.role}</span>}
          {data.draft && <span class="draft-badge">下書き・ローカル限定</span>}
        </div>
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <p class="article-description">{data.description}</p>
        <ul class="tech-list" aria-label="使用技術">
          {data.technologies.map((tech) => <li>{tech}</li>)}
        </ul>
        {(data.repositoryUrl || data.websiteUrl) && (
          <div class="project-links">
            {data.repositoryUrl && (
              <a class="button button-secondary" href={data.repositoryUrl}>
                GitHub ↗
              </a>
            )}
            {data.websiteUrl && (
              <a class="button button-primary" href={data.websiteUrl}>
                サイトを開く ↗
              </a>
            )}
          </div>
        )}
        {data.cover && (
          <ContentImage
            class="article-cover"
            src={data.cover}
            alt={data.coverAlt ?? data.title}
            kind="cover"
          />
        )}
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <a class="back-link" href="/projects/">← プロジェクト一覧に戻る</a>
  </div>
</Base>
